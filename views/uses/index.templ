package uses

import (
    "github.com/alejandrobyrne/website/views/layout"
)

templ Page() {
    @layout.Base("Uses | Alejandro Byrne", "Hardware, software, and tools Alejandro Byrne uses.", "https://alejandrobyrne.com/uses") {
        <section class="max-w-4xl mx-auto py-12">
            <h1 class="text-3xl font-bold mb-6 uppercase tracking-widest border-b-2 border-black pb-2 inline-block">Uses</h1>
            <div class="space-y-6 leading-relaxed">
                <div>
                    <h2 class="font-bold uppercase">Hardware</h2>
                    <ul class="list-disc list-inside space-y-1">
                        <li>Laptop: MacBook Pro</li>
                        <li>Watch: Garmin</li>
                        <li>Camera: —</li>
                    </ul>
                </div>
                <div>
                    <h2 class="font-bold uppercase">Software</h2>
                    <ul class="list-disc list-inside space-y-1">
                        <li>Editor: VS Code</li>
                        <li>Shell: zsh</li>
                        <li>Terminal: iTerm2</li>
                    </ul>
                </div>
                <div>
                    <h2 class="font-bold uppercase">Writing</h2>
                    <ul class="list-disc list-inside space-y-1">
                        <li>Substack for posts</li>
                        <li>Notes: —</li>
                    </ul>
                </div>
            </div>
        </section>
    }
}

