package now

import (
    "github.com/alejandrobyrne/website/views/layout"
)

templ Page() {
    @layout.Base("Now | Alejandro Byrne", "What Alejandro Byrne is focused on right now.", "https://alejandrobyrne.com/now") {
        <section class="max-w-4xl mx-auto py-12">
            <h1 class="text-3xl font-bold mb-6 uppercase tracking-widest border-b-2 border-black pb-2 inline-block">Now</h1>
            <div class="space-y-4 leading-relaxed">
                <p class="font-mono">This page lists what I’m actively focused on. Updated periodically.</p>

                <h2 class="font-bold uppercase mt-8">Current Focus</h2>
                <ul class="list-disc list-inside space-y-1">
                    <li>Study: .NET / Go / Azure depth</li>
                    <li>Projects: Selected engineering + writing</li>
                    <li>Training: Daily strength + running</li>
                </ul>

                <h2 class="font-bold uppercase mt-8">What I’m Saying No To</h2>
                <ul class="list-disc list-inside space-y-1">
                    <li>Excess screen time</li>
                    <li>Non-essential commitments</li>
                </ul>
            </div>
        </section>
    }
}

